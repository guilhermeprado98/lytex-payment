# Logs de cada requisição HTTP: texto (padrão) ou json (uma linha JSON por request, útil para agregadores)
LOG_FORMAT=text

# Gravar cada requisição na coleção MongoDB access_logs (true/false; padrão true)
LOG_TO_DB=true
